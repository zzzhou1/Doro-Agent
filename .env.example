# Fill in one provider only. Copy this file to .env before editing.

# OpenAI or OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic or Anthropic-compatible provider
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Model override (optional). Without one, each backend uses its built-in default:
#   anthropic -> claude-opus-5   openai -> gpt-5.6-sol
# OPENAI_MODEL=            # applies to the OpenAI backend only
# ANTHROPIC_MODEL=         # applies to the Anthropic backend only
# (DORO_MODEL was removed: being global, it leaked a model name from one
#  provider into the other. Use the per-backend variables above.)

# Reasoning effort (optional): auto, off, minimal, low, medium, high, xhigh, max
# Built-in default: medium. Backend support varies; unsupported values fail loudly.
# OPENAI_REASONING_EFFORT=  # OpenAI backend only
# ANTHROPIC_EFFORT=         # Anthropic backend only (minimal is unsupported)
# DORO_EFFORT=       # fallback for every backend

# Token pricing (optional), USD per MILLION tokens. Only publicly documented
# first-party list prices ship built in; anything else (gateway aliases such as
# gpt-5.6-sol or claude-opus-5) is reported as "estimated" until you set it here.
# Per-model, JSON:
# DORO_PRICES={"gpt-5.6-sol": {"input": 2, "output": 8, "cache_write": 2.5, "cache_read": 0.4}}
# Or one number for every model:
# DORO_PRICE_INPUT=
# DORO_PRICE_OUTPUT=
# DORO_PRICE_CACHE_WRITE=
# DORO_PRICE_CACHE_READ=

# Context window (optional), in tokens. Every model shares one default of 272000;
# this single value drives the status-bar denominator AND the auto-compaction
# trigger (85% of window - 20000), so a wrong number moves when compaction fires.
# Set it only if this deployment really serves a different limit.
# DORO_CONTEXT_WINDOW=

# Diagnose the effective setup from inside the REPL with /config and /doctor.

