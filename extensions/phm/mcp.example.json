{
  "mcpServers": {
    "phm": {
      "command": "uv",
      "args": ["run", "--project", "extensions/phm", "phm-mcp"],
      "cwd": ".",
      "readOnly": true,
      "connectTimeout": 30,
      "toolTimeout": 60
    },
    "phm-admin": {
      "command": "uv",
      "args": ["run", "--project", "extensions/phm", "phm-admin-mcp"],
      "cwd": ".",
      "readOnly": false,
      "connectTimeout": 30,
      "toolTimeout": 15
    }
  }
}
